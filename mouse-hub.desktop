[Desktop Entry]
Type=Application
Name=Mouse Hub
GenericName=Input Automation Hub
Comment=Controle e automação local de mouse e teclado, com hardware baseado em capabilities
Exec=/bin/bash -c 'cd /opt/mouse-hub && ./launcher.sh'
Icon=mouse-hub
Terminal=false
Categories=Utility;Settings;HardwareSettings;
