#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
VERSION=0.46.0
TAG="v$VERSION"
case "$(uname -m)" in
  x86_64)
    ASSET="rtk-x86_64-unknown-linux-musl.tar.gz"
    SHA256="79aa5b89c69566bbfeceb66c8a27cfbe52237fc7ee3e683115f43745a3262d21"
    ;;
  aarch64|arm64)
    ASSET="rtk-aarch64-unknown-linux-gnu.tar.gz"
    SHA256="e8c2e1787f46017ea7c5a711b2bc6a7f7cf61c7ad69385b4c1e4daff1135dcd1"
    ;;
  *)
    echo "RTK bootstrap: unsupported architecture: $(uname -m)" >&2
    exit 2
    ;;
esac

CACHE="$ROOT/.tools/rtk/downloads"
BIN_DIR="$ROOT/.tools/rtk/bin"
ARCHIVE="$CACHE/$ASSET"
BIN="$BIN_DIR/rtk"
mkdir -p "$CACHE" "$BIN_DIR"

if [ -x "$BIN" ] && "$BIN" --version 2>/dev/null | grep -q "^rtk $VERSION$"; then
  echo "RTK $VERSION already installed at $BIN"
  exit 0
fi

if [ ! -f "$ARCHIVE" ] || [ "$(sha256sum "$ARCHIVE" | awk '{print $1}')" != "$SHA256" ]; then
  tmp="$ARCHIVE.tmp.$$"
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  url="https://github.com/rtk-ai/rtk/releases/download/$TAG/$ASSET"
  echo "Downloading official RTK $TAG ($ASSET)"
  curl --fail --location --silent --show-error --retry 2 --output "$tmp" "$url"
  printf '%s  %s\n' "$SHA256" "$tmp" | sha256sum -c -
  mv "$tmp" "$ARCHIVE"
  trap - EXIT HUP INT TERM
fi

printf '%s  %s\n' "$SHA256" "$ARCHIVE" | sha256sum -c - >/dev/null
rm -rf "$BIN_DIR/.extract"
mkdir -p "$BIN_DIR/.extract"
[ "$(tar -tzf "$ARCHIVE")" = "rtk" ] || {
  echo "RTK bootstrap: unexpected archive layout" >&2
  exit 3
}
tar -xzf "$ARCHIVE" -C "$BIN_DIR/.extract"
mv "$BIN_DIR/.extract/rtk" "$BIN"
rm -rf "$BIN_DIR/.extract"
chmod 755 "$BIN"
"$BIN" --version
